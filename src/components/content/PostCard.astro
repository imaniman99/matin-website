---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import CoverArt from './CoverArt.astro';
import { slugOf } from '@/lib/content';
import { baseLang, href as link, type UiLang } from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import { formatDate } from '@/lib/dates';

interface Props {
  post: CollectionEntry<'news'>;
  lang: UiLang;
  headingLevel?: 'h2' | 'h3';
}
const { post, lang, headingLevel = 'h3' } = Astro.props;
const t = useTranslations(lang);
const d = post.data;
const href = link('news', lang, slugOf(post, baseLang(lang)));
const Heading = headingLevel;
// Illustration used when the article has no photo.
const cover = d.category === 'updates' ? 'community' : 'celebration';
---

<article class="group relative flex flex-col">
  <div class="relative mb-5 aspect-[3/2] overflow-hidden rounded-[var(--radius-card)] shadow-soft">
    {d.image ? (
      <Picture
        src={d.image}
        alt={pick(d.imageAlt, lang) ?? ''}
        formats={['avif', 'webp']}
        widths={[400, 640, 800]}
        sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
        class="size-full object-cover transition duration-500 group-hover:scale-[1.03]"
      />
    ) : (
      <CoverArt
        category={cover}
        seed={post.id}
        class="size-full transition duration-500 group-hover:scale-[1.03]"
      />
    )}
  </div>
  <p class="mb-2 text-sm text-muted">
    <time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(d.date, lang)}</time>
    <span aria-hidden="true" class="mx-1.5 text-gold">
      •
    </span>
    <span class="font-semibold text-gold-text">{t(`newsCategories.${d.category}`)}</span>
  </p>
  <Heading class="mb-2 text-xl leading-snug font-bold">
    <a
      href={href}
      class="text-primary no-underline group-hover:text-teal after:absolute after:inset-0 after:content-['']"
    >
      {pick(d.title, lang)}
    </a>
  </Heading>
  <p class="text-[0.95rem] text-muted">{pick(d.excerpt, lang)}</p>
</article>
