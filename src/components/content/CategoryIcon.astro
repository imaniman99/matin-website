---
import {
  Languages,
  Palette,
  Sprout,
  Users,
  Compass,
  BookOpen,
  Music,
  Sparkles,
} from '@lucide/astro';
import type { Category } from '@/lib/taxonomy';

interface Props {
  category: Category;
  size?: number;
  class?: string;
  strokeWidth?: number;
}
const { category, size = 24, class: className, strokeWidth = 1.75 } = Astro.props;
const icons = {
  language: Languages,
  arts: Palette,
  youth: Sprout,
  community: Users,
  newcomers: Compass,
  lectures: BookOpen,
  music: Music,
  celebration: Sparkles,
} as const;
const Icon = icons[category];
---

<Icon size={size} class={className} stroke-width={strokeWidth} aria-hidden="true" />
