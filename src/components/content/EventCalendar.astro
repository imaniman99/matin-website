---
/**
 * Month-grid calendar of upcoming events (Monday-first, Québec convention).
 * All months are rendered statically; JS shows one month at a time with prev/next.
 */
import { ChevronLeft, ChevronRight } from '@lucide/astro';
import type { EventEntry } from '@/lib/content';
import { slugOf } from '@/lib/content';
import { path, type Lang } from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import { formatTime, formatLongDate } from '@/lib/dates';

interface Props {
  lang: Lang;
  events: EventEntry[];
}
const { lang, events } = Astro.props;
const t = useTranslations(lang);
const weekdays = t('events.weekdays').split(',');
const loc = lang === 'fr' ? 'fr-CA' : 'en-CA';

// Months from the current month to the month of the last upcoming event.
const now = new Date();
const startKey = events[0]?.data.start.slice(0, 7) ?? now.toISOString().slice(0, 7);
const endKey = events.at(-1)?.data.start.slice(0, 7) ?? startKey;
const months: { key: string; y: number; m: number }[] = [];
for (
  let [y, m] = startKey.split('-').map(Number);
  `${y}-${String(m).padStart(2, '0')}` <= endKey;
) {
  months.push({ key: `${y}-${String(m).padStart(2, '0')}`, y, m });
  m++;
  if (m > 12) {
    m = 1;
    y++;
  }
}

const byDay = new Map<string, EventEntry[]>();
for (const e of events) {
  const day = e.data.start.slice(0, 10);
  byDay.set(day, [...(byDay.get(day) ?? []), e]);
}

function weeks(y: number, m: number) {
  const first = new Date(Date.UTC(y, m - 1, 1));
  const lead = (first.getUTCDay() + 6) % 7; // Monday = 0
  const days = new Date(Date.UTC(y, m, 0)).getUTCDate();
  const cells: (number | null)[] = [...Array(lead).fill(null)];
  for (let d = 1; d <= days; d++) cells.push(d);
  while (cells.length % 7) cells.push(null);
  return Array.from({ length: cells.length / 7 }, (_, i) => cells.slice(i * 7, i * 7 + 7));
}
const monthLabel = (y: number, m: number) =>
  new Intl.DateTimeFormat(loc, { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(
    new Date(Date.UTC(y, m - 1, 15)),
  );
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class="calendar" data-calendar>
  <div class="mb-5 flex items-center justify-between gap-4">
    <button type="button" class="cal-nav" data-cal-prev>
      <ChevronLeft size={20} aria-hidden="true" />
      <span class="sr-only">{t('events.prevMonth')}</span>
    </button>
    <p
      class="font-display text-2xl font-bold text-primary first-letter:uppercase"
      aria-live="polite"
      data-cal-label
    >
      {monthLabel(months[0].y, months[0].m)}
    </p>
    <button type="button" class="cal-nav" data-cal-next>
      <ChevronRight size={20} aria-hidden="true" />
      <span class="sr-only">{t('events.nextMonth')}</span>
    </button>
  </div>

  {months.map(({ key, y, m }, i) => (
    <div data-cal-month={key} data-cal-title={monthLabel(y, m)} hidden={i > 0}>
      <table class="cal-table">
        <caption class="sr-only">{monthLabel(y, m)}</caption>
        <thead>
          <tr>
            {weekdays.map((w) => (
              <th scope="col" class="text-xs font-bold tracking-wider text-muted uppercase">
                {w}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {weeks(y, m).map((week) => (
            <tr>
              {week.map((day) => {
                if (!day) return <td class="cal-empty" />;
                const iso = `${y}-${pad(m)}-${pad(day)}`;
                const list = byDay.get(iso) ?? [];
                return (
                  <td class:list={['cal-day', list.length && 'has-events']}>
                    <span class="cal-num" aria-hidden={list.length ? 'true' : undefined}>
                      {day}
                    </span>
                    {list.length > 0 && (
                      <ul
                        aria-label={t('events.eventsOn', {
                          date: formatLongDate(list[0].startDate, lang),
                        })}
                      >
                        {list.map((e) => (
                          <li data-category={e.data.category}>
                            <a href={path('events', lang, slugOf(e, lang))} class="cal-event">
                              <span class="cal-time">{formatTime(e.startDate, lang)}</span>
                              {pick(e.data.title, lang)}
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-calendar]').forEach((cal) => {
    const months = [...cal.querySelectorAll<HTMLElement>('[data-cal-month]')];
    const label = cal.querySelector<HTMLElement>('[data-cal-label]')!;
    const prev = cal.querySelector<HTMLButtonElement>('[data-cal-prev]')!;
    const next = cal.querySelector<HTMLButtonElement>('[data-cal-next]')!;
    let i = 0;
    const show = (n: number) => {
      i = Math.max(0, Math.min(months.length - 1, n));
      months.forEach((mo, k) => (mo.hidden = k !== i));
      label.textContent = months[i].dataset.calTitle ?? '';
      prev.disabled = i === 0;
      next.disabled = i === months.length - 1;
    };
    prev.addEventListener('click', () => show(i - 1));
    next.addEventListener('click', () => show(i + 1));
    // Lets the events page jump to a month chosen in the month filter.
    cal.addEventListener('calendar:goto', (e) => {
      const key = (e as CustomEvent<string>).detail;
      const idx = months.findIndex((mo) => mo.dataset.calMonth === key);
      if (idx >= 0) show(idx);
    });
    show(0);
  });
</script>

<style>
  .cal-table {
    width: 100%;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 4px;
  }
  .cal-table th {
    padding-bottom: 0.4rem;
  }
  .cal-day {
    vertical-align: top;
    height: 6.5rem;
    padding: 0.4rem;
    border-radius: 0.75rem;
    background: white;
    box-shadow: inset 0 0 0 1px rgb(11 61 92 / 0.07);
  }
  .cal-day.has-events {
    background: linear-gradient(180deg, #fff, var(--color-cream));
    box-shadow: inset 0 0 0 1.5px var(--color-gold);
  }
  .cal-num {
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .has-events .cal-num {
    color: var(--color-primary);
  }
  .cal-event {
    display: block;
    margin-top: 0.3rem;
    padding: 0.3rem 0.45rem;
    border-radius: 0.45rem;
    font-size: 0.75rem;
    line-height: 1.3;
    font-weight: 600;
    color: white;
    background: var(--color-primary);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .cal-event:hover {
    background: var(--color-teal);
  }
  .cal-time {
    display: block;
    font-weight: 500;
    color: var(--color-gold-light);
  }
  .cal-nav {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    color: var(--color-primary);
    background: white;
    border: 1.5px solid rgb(11 61 92 / 0.2);
    cursor: pointer;
  }
  .cal-nav:disabled {
    opacity: 0.35;
    cursor: default;
  }
  @media (max-width: 640px) {
    .cal-day {
      height: 4.5rem;
      padding: 0.25rem;
    }
    .cal-event {
      font-size: 0;
      height: 0.5rem;
      padding: 0;
      margin-top: 0.25rem;
      background: var(--color-gold);
    }
    .cal-event .cal-time {
      display: none;
    }
  }
</style>
