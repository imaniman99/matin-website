---
/**
 * Accessible testimonials carousel (WAI-ARIA APG pattern):
 * pause/play button, prev/next, stops on hover/focus, no auto-rotation
 * when the visitor prefers reduced motion. Works without JS (all quotes listed).
 */
import { ChevronLeft, ChevronRight, Pause, Play, Quote } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import { NBSP } from '@/lib/frenchTypo';

interface Props {
  items: CollectionEntry<'testimonials'>[];
  lang: Lang;
  labelledBy: string;
}
const { items, lang, labelledBy } = Astro.props;
const t = useTranslations(lang);
const total = items.length;
// « guillemets » with non-breaking spaces in French, “curly quotes” in English.
const quoted = (q: string) => (lang === 'fr' ? `«${NBSP}${q}${NBSP}»` : `“${q}”`);
---

<div
  class="carousel relative mx-auto max-w-3xl text-center"
  role="region"
  aria-roledescription="carousel"
  aria-labelledby={labelledBy}
  data-carousel
  data-label-pause={t('carousel.pause')}
  data-label-play={t('carousel.play')}
>
  <Quote size={52} class="mx-auto mb-4 text-gold" aria-hidden="true" stroke-width={1.25} />
  <div class="carousel__viewport" aria-live="off" data-viewport>
    {items.map((item, i) => (
      <div
        class="carousel__slide"
        role="group"
        aria-roledescription="slide"
        aria-label={t('carousel.slideOf', { n: i + 1, total })}
        data-slide
      >
        <figure>
          <blockquote class="font-display text-2xl leading-snug text-primary italic sm:text-[1.9rem]">
            <p>{quoted(pick(item.data.quote, lang) ?? '')}</p>
          </blockquote>
          <figcaption class="mt-6">
            <span class="block font-semibold text-ink">{item.data.name}</span>
            {item.data.role && <span class="text-sm text-muted">{pick(item.data.role, lang)}</span>}
          </figcaption>
        </figure>
      </div>
    ))}
  </div>

  {total > 1 && (
    <div class="carousel__controls mt-8 hidden items-center justify-center gap-3" data-controls>
      <button type="button" class="ctrl" data-rotation>
        <Pause size={18} aria-hidden="true" data-icon-pause />
        <Play size={18} aria-hidden="true" data-icon-play class="hidden" />
        <span class="sr-only" data-rotation-label>
          {t('carousel.pause')}
        </span>
      </button>
      <button type="button" class="ctrl" data-prev>
        <ChevronLeft size={20} aria-hidden="true" />
        <span class="sr-only">{t('carousel.previous')}</span>
      </button>
      <div class="flex gap-2" aria-hidden="true">
        {items.map((_, i) => (
          <span class="dot" data-dot={i} />
        ))}
      </div>
      <button type="button" class="ctrl" data-next>
        <ChevronRight size={20} aria-hidden="true" />
        <span class="sr-only">{t('carousel.next')}</span>
      </button>
    </div>
  )}
</div>

<script>
  const INTERVAL = 7000;
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    if (slides.length < 2) return;
    const viewport = root.querySelector<HTMLElement>('[data-viewport]')!;
    const controls = root.querySelector<HTMLElement>('[data-controls]')!;
    const rotationBtn = root.querySelector<HTMLButtonElement>('[data-rotation]')!;
    const rotationLabel = root.querySelector<HTMLElement>('[data-rotation-label]')!;
    const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let index = 0;
    let timer: number | undefined;
    // User intent: explicit pause sticks; hover/focus only pause temporarily.
    let userPaused = reduced;
    let hoverPaused = false;

    root.classList.add('is-enhanced');
    controls.classList.remove('hidden');
    controls.classList.add('flex');

    const show = (i: number) => {
      index = (i + slides.length) % slides.length;
      slides.forEach((s, n) => {
        s.hidden = n !== index;
      });
      dots.forEach((d, n) => d.classList.toggle('is-active', n === index));
    };
    const tick = () => {
      window.clearTimeout(timer);
      const running = !userPaused && !hoverPaused;
      viewport.setAttribute('aria-live', running ? 'off' : 'polite');
      if (running) timer = window.setTimeout(() => (show(index + 1), tick()), INTERVAL);
    };
    const syncButton = () => {
      rotationLabel.textContent = userPaused ? root.dataset.labelPlay! : root.dataset.labelPause!;
      rotationBtn.querySelector('[data-icon-pause]')?.classList.toggle('hidden', userPaused);
      rotationBtn.querySelector('[data-icon-play]')?.classList.toggle('hidden', !userPaused);
    };

    rotationBtn.addEventListener('click', () => {
      userPaused = !userPaused;
      syncButton();
      tick();
    });
    root.querySelector('[data-prev]')?.addEventListener('click', () => (show(index - 1), tick()));
    root.querySelector('[data-next]')?.addEventListener('click', () => (show(index + 1), tick()));
    root.addEventListener('mouseenter', () => ((hoverPaused = true), tick()));
    root.addEventListener('mouseleave', () => ((hoverPaused = false), tick()));
    root.addEventListener('focusin', () => ((hoverPaused = true), tick()));
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node)) {
        hoverPaused = false;
        tick();
      }
    });

    show(0);
    syncButton();
    tick();
  });
</script>

<style>
  /* Without JS every quote is listed; with JS only the current one shows. */
  .carousel:not(.is-enhanced) .carousel__slide + .carousel__slide {
    margin-top: 2.5rem;
  }
  .carousel.is-enhanced .carousel__viewport {
    display: grid;
    min-height: 12rem;
    align-items: center;
  }
  .carousel__slide:not([hidden]) {
    animation: fade 0.5s ease;
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  .ctrl {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    color: var(--color-primary);
    border: 1.5px solid color-mix(in srgb, var(--color-primary) 25%, transparent);
    background: white;
    cursor: pointer;
    transition: all 0.2s;
  }
  .ctrl:hover {
    background: var(--color-primary);
    color: white;
  }
  .dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-primary) 20%, transparent);
    transition: all 0.3s;
  }
  .dot.is-active {
    width: 1.6rem;
    background: var(--color-gold);
  }
</style>
