---
import { siFacebook, siInstagram, siYoutube } from 'simple-icons';
import type { UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';

interface Props {
  lang: UiLang;
  social: Partial<Record<'facebook' | 'instagram' | 'youtube' | 'linkedin', string>>;
  class?: string;
}
const { lang, social, class: className = '' } = Astro.props;
const t = useTranslations(lang);

// LinkedIn is not distributed by simple-icons; standard glyph path.
const linkedinPath =
  'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0z';

const networks = [
  { key: 'youtube', label: 'YouTube', path: siYoutube.path },
  { key: 'linkedin', label: 'LinkedIn', path: linkedinPath },
  { key: 'instagram', label: 'Instagram', path: siInstagram.path },
  { key: 'facebook', label: 'Facebook', path: siFacebook.path },
] as const;
const present = networks.filter((n) => social[n.key]);
---

{present.length > 0 && (
  <ul class:list={['flex flex-wrap gap-2', className]} aria-label={t('a11y.social')}>
    {present.map((n) => (
      <li>
        <a href={social[n.key]} target="_blank" rel="noopener noreferrer" class="social-link">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
            <path d={n.path} />
          </svg>
          <span class="sr-only">
            {n.label} {t('a11y.externalLink')}
          </span>
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  .social-link {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    color: var(--color-primary);
    background: var(--color-white);
    border: 1px solid var(--color-line);
    transition:
      background 0.2s,
      color 0.2s;
  }
  .social-link:hover {
    border-color: var(--color-gold);
    background: var(--color-tint);
  }
</style>
