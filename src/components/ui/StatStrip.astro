---
import type { Lang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';

interface Props {
  lang: Lang;
  impact: { years: number; cultures: number; participants: number; events: number };
}
const { lang, impact } = Astro.props;
const t = useTranslations(lang);
const nf = new Intl.NumberFormat(lang === 'fr' ? 'fr-CA' : 'en-CA');
const stats = [
  { value: impact.years, label: t('impact.years') },
  { value: impact.cultures, label: t('impact.cultures'), plus: true },
  { value: impact.participants, label: t('impact.participants'), plus: true },
  { value: impact.events, label: t('impact.events'), plus: true },
];
---

<section
  class="on-dark relative isolate overflow-hidden bg-primary py-16 text-white sm:py-20"
  aria-labelledby="impact-title"
>
  <div
    class="absolute inset-0 -z-10 opacity-70"
    style="background: radial-gradient(60% 120% at 50% 120%, rgb(217 164 65 / 0.35), transparent 60%), radial-gradient(40% 80% at 0% 0%, rgb(108 207 227 / 0.25), transparent 60%);"
    aria-hidden="true"
  ></div>
  <div class="container-site">
    <h2 id="impact-title" class="sr-only">
      {t('home.impactTitle')}
    </h2>
    <dl class="grid grid-cols-2 gap-x-6 gap-y-10 text-center lg:grid-cols-4">
      {stats.map((s, i) => (
        <div data-reveal style={`--reveal-delay:${i * 90}ms`} class="flex flex-col-reverse">
          <dt class="mt-2 text-sm font-semibold tracking-wide text-aqua-light uppercase sm:text-[0.95rem]">
            {s.label}
          </dt>
          <dd class="font-display text-5xl font-bold text-gold-light sm:text-6xl">
            {nf.format(s.value)}
            {s.plus && <span class="text-gold">+</span>}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
