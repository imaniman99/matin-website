---
import { ArrowRight } from '@lucide/astro';
import LeafRule from '@/components/brand/LeafRule.astro';

interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  lede?: string;
  link?: { href: string; label: string };
  align?: 'left' | 'center';
}
const { id, eyebrow, title, lede, link, align = 'left' } = Astro.props;
const centered = align === 'center';
---

<div
  class:list={[
    'mb-12 flex flex-col gap-6',
    centered ? 'items-center text-center' : 'md:flex-row md:items-end md:justify-between',
  ]}
  data-reveal
>
  <div class:list={['max-w-2xl', centered && 'flex flex-col items-center']}>
    {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
    <h2 id={id} class="section-title">
      {title}
    </h2>
    <LeafRule class:list={['mt-5 w-40', centered && 'mx-auto']} />
    {lede && <p class="lede mt-5">{lede}</p>}
  </div>
  {link && (
    <a href={link.href} class="link-arrow shrink-0">
      {link.label}
      <ArrowRight size={18} aria-hidden="true" />
    </a>
  )}
</div>
