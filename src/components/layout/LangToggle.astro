---
/**
 * FR | EN | فارسی — links to the equivalent page in each language. Persian links to
 * the home page of the Persian site when the current page has no Persian version.
 */
import { uiLanguages, type Alternates, type UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';

interface Props {
  lang: UiLang;
  alternates: Alternates;
  large?: boolean;
}
const { lang, alternates, large = false } = Astro.props;
const t = useTranslations(lang);

// Each label and description is written in its own language.
const labels: Record<UiLang, { text: string; full: string; go: string }> = {
  fr: { text: 'FR', full: 'Français', go: 'Lire cette page en français' },
  en: { text: 'EN', full: 'English', go: 'Read this page in English' },
  fa: {
    text: 'فارسی',
    full: 'فارسی',
    go: alternates.fa ? 'این صفحه را به فارسی بخوانید' : 'رفتن به نسخه فارسی سایت',
  },
};
const target = (l: UiLang) => alternates[l] ?? '/fa/';
const htmlLang = (l: UiLang) => (l === 'fr' ? 'fr-CA' : l === 'en' ? 'en-CA' : 'fa');
---

<nav
  aria-label={t('a11y.languageSwitcher')}
  class:list={['lang-toggle', large && 'lang-toggle--large']}
>
  {uiLanguages.map((l, i) => (
    <>
      {i > 0 && (
        <span class="sep" aria-hidden="true">
          |
        </span>
      )}
      {l === lang ? (
        <span
          class:list={['current', l === 'fa' && 'fa-label']}
          aria-current="true"
          lang={htmlLang(l)}
          dir={l === 'fa' ? 'rtl' : undefined}
        >
          <abbr title={labels[l].full}>{labels[l].text}</abbr>
        </span>
      ) : (
        <a
          href={target(l)}
          hreflang={htmlLang(l)}
          lang={htmlLang(l)}
          dir={l === 'fa' ? 'rtl' : undefined}
          class:list={[l === 'fa' && 'fa-label']}
          data-lang-switch={l}
        >
          {labels[l].text}
          <span class="sr-only"> – {labels[l].go}</span>
        </a>
      )}
    </>
  ))}
</nav>

<style>
  .lang-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }
  .lang-toggle abbr {
    text-decoration: none;
  }
  .current {
    color: var(--color-ink);
    border-block-end: 2px solid var(--color-gold);
    padding: 0.35rem 0.2rem 0.15rem;
  }
  .sep {
    color: var(--color-line);
  }
  a {
    display: inline-block;
    color: var(--color-muted);
    text-decoration: none;
    padding: 0.35rem 0.3rem;
    border-radius: 6px;
    min-width: 2rem;
    text-align: center;
  }
  a:hover {
    color: var(--color-ink);
    background: var(--color-tint);
  }
  .fa-label {
    font-size: 1.1875rem;
    letter-spacing: 0;
  }
  .lang-toggle--large {
    gap: 0.6rem;
    font-size: 1.1rem;
  }
  .lang-toggle--large a,
  .lang-toggle--large .current {
    min-height: 2.75rem;
    min-width: 2.75rem;
    display: inline-grid;
    place-items: center;
  }
</style>
