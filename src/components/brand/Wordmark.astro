---
/**
 * Large "Matin" wordmark as SVG: turquoise fill with a gold rim. Decorative — the accessible name is provided by the parent.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg
  class:list={['wordmark', className]}
  viewBox="0 0 620 180"
  aria-hidden="true"
  focusable="false"
>
  <!-- prettier-ignore -->
  <text x="310" y="142" text-anchor="middle" textLength="580" lengthAdjust="spacingAndGlyphs" fill="var(--color-primary)" stroke="var(--color-gold)" stroke-width="4" paint-order="stroke" stroke-linejoin="round">Matin</text>
</svg>

<style>
  .wordmark text {
    font-family: var(--font-brand);
    font-weight: 800;
    font-size: 168px;
    letter-spacing: -0.01em;
  }
  .wordmark {
    overflow: visible;
  }
</style>
