---
/**
 * Soft flowing aqua-and-gold wave between two sections.
 * `from` = colour of the section above, `to` = colour of the section below.
 */
interface Props {
  from?: string;
  to?: string;
  flip?: boolean;
  gold?: boolean;
  class?: string;
}
const {
  from = 'var(--color-cream)',
  to = 'white',
  flip = false,
  gold = true,
  class: className = '',
} = Astro.props;
---

<div class:list={['wave', className]} style={`background:${from}`} aria-hidden="true">
  <svg
    viewBox="0 0 1440 110"
    preserveAspectRatio="none"
    overflow="visible"
    style={flip ? 'transform:scaleX(-1)' : ''}
  >
    <path
      d="M0 58 C 240 18 420 98 720 62 S 1200 14 1440 52 V110 H0Z"
      fill="var(--color-aqua)"
      opacity="0.28"
    ></path>
    <path d="M0 74 C 260 40 470 108 760 76 S 1220 40 1440 70 V114 H0Z" fill={to}></path>
    {gold && (
      <path
        d="M0 66 C 250 30 450 104 740 70 S 1210 28 1440 62"
        fill="none"
        stroke="var(--color-gold)"
        stroke-width="1.6"
        opacity="0.85"
        vector-effect="non-scaling-stroke"
      />
    )}
  </svg>
</div>

<style>
  .wave {
    position: relative;
    z-index: 1;
    line-height: 0;
    margin-top: -1px;
    /* Overlap the next section slightly to hide sub-pixel seams. */
    margin-bottom: -3px;
  }
  .wave svg {
    display: block;
    width: 100%;
    height: clamp(42px, 6vw, 96px);
  }
</style>
