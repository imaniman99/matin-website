---
/**
 * Homepage hero: a full-width photo banner (Montréal skyline) right under the
 * header, with the institute's name, the tagline in gold italic, a thin gold
 * line, the paragraph and the two buttons centered on it. The photo is shown as
 * is, with no veil; the text is dark so it reads on the bright sky.
 */
import '@fontsource/playfair-display/700-italic.css';
import { Picture } from 'astro:assets';
import banner from '@/assets/home/hero-banner.jpg';
import { href, type UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__media" aria-hidden="true">
    <Picture
      src={banner}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[640, 960, 1280]}
      sizes="100vw"
      alt=""
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="container-site hero__inner">
    <div class="hero__text">
      <h1 id="hero-title" class="hero__title">
        {t('home.heroEyebrow')}
      </h1>
      <p class="hero__tagline">{t('home.heroTitle')}</p>
      <span class="hero__rule" aria-hidden="true"></span>
      <p class="hero__paragraph">{t('home.heroText')}</p>
      <div class="hero__actions">
        <a href={href('about', lang)} class="btn btn-primary">
          {t('home.heroCtaWho')}
        </a>
        <a href={href('getInvolved', lang)} class="btn btn-outline">
          {t('home.heroCtaInvolved')}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: clamp(34rem, 22rem + 30vw, 44rem);
    overflow: hidden;
    isolation: isolate;
    background: var(--color-white);
    border-block-end: 1px solid var(--color-line);
  }

  /* Full-width photo behind the text. The skyline sits in the lower middle of
     the photo, so that is the part kept in view when the sides are cropped. */
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 65%;
  }
  .hero__inner {
    padding-block: clamp(3rem, 2rem + 4vw, 5.5rem);
  }
  .hero__text {
    max-width: 76rem;
    margin-inline: auto;
    text-align: center;
  }
  /* The institute's name: the main heading, deep petroleum blue. */
  .hero__title {
    font-size: clamp(1.875rem, 0.95rem + 3.4vw, 3.875rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: 0.03em;
    text-wrap: balance;
    color: var(--color-primary);
    overflow-wrap: break-word;
  }
  /* Tagline: warm gold in the logo's serif, bold italic so the strokes are
     thick enough to read on the bright sky; a crisp 1px shadow (no glow) gives
     the gold an edge against the clouds. Smaller than the name. */
  .hero__tagline {
    margin-block-start: 0.5rem;
    font-family: var(--font-brand);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(1.5rem, 0.9rem + 2.2vw, 2.75rem);
    line-height: 1.3;
    color: var(--color-gold);
    text-shadow: 0 1px 1px color-mix(in srgb, var(--color-primary) 45%, transparent);
  }
  /* Persian: the brand serif has no Persian letters. */
  :global(html[lang='fa']) .hero__tagline {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 800;
  }
  /* Very thin gold line under the tagline. */
  .hero__rule {
    display: block;
    width: 7rem;
    height: 1.5px;
    margin: 1.25rem auto 1.75rem;
    background: var(--color-gold);
  }
  /* About 26px on desktop with long lines, so the paragraph fits in three lines
     on screens 1280px and wider (all three languages). */
  .hero__paragraph {
    max-width: 76rem;
    margin-inline: auto;
    font-size: clamp(1.3125rem, 1.05rem + 0.75vw, 1.6875rem);
    line-height: 1.75;
    font-weight: 600;
    color: var(--color-primary);
    /* Soft white halo so the dark letters stay readable where the paragraph
       crosses the darker buildings of the skyline. */
    text-shadow:
      0 0 3px var(--color-white),
      0 0 8px var(--color-white),
      0 0 16px color-mix(in srgb, var(--color-white) 90%, transparent);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.875rem;
    margin-block-start: 2.5rem;
  }
  @media (max-width: 29.99rem) {
    .hero__actions .btn {
      width: 100%;
    }
  }
</style>
