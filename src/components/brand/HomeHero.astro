---
/**
 * Homepage hero: text on the left, the original round Matin logo on the right.
 * The logo is the untouched raster file, only cropped to a circle (nothing added
 * around it). On phones and tablets the text comes first, then the logo.
 */
import { Picture } from 'astro:assets';
import logo from '@/assets/brand/logo-circle.png';
import { href, type UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container-site hero__grid">
    <div class="hero__text">
      <p class="eyebrow hero__label">{t('home.heroEyebrow')}</p>
      <h1 id="hero-title" class="hero__title">
        {t('home.heroTitle')}
      </h1>
      <span class="hero__rule" aria-hidden="true"></span>
      <p class="hero__paragraph">{t('home.heroText')}</p>
      <div class="hero__actions">
        <a href={href('about', lang)} class="btn btn-primary">
          {t('home.heroCtaWho')}
        </a>
        <a href={href('getInvolved', lang)} class="btn btn-gold">
          {t('home.heroCtaInvolved')}
        </a>
      </div>
    </div>
    <div class="hero__logo">
      <Picture
        src={logo}
        formats={['avif', 'webp']}
        widths={[280, 440, 560, 800]}
        sizes="(min-width: 64rem) 30rem, (min-width: 40rem) 22rem, 17rem"
        alt={t('home.heroLogoAlt')}
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    background: white;
    border-block-end: 1px solid var(--color-line);
  }
  .hero__grid {
    display: grid;
    gap: 3rem;
    align-items: center;
    padding-block: clamp(3rem, 2rem + 4vw, 6.5rem);
  }
  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: 4rem;
    }
  }
  .hero__label {
    margin-block-end: 1.25rem;
    /* About 22px on desktop, never below 19px (bold, so gold-dark stays legible). */
    font-size: clamp(1.1875rem, 1rem + 0.5vw, 1.375rem);
  }
  .hero__title {
    font-size: clamp(2.75rem, 1.4rem + 5.4vw, 5.5rem);
    font-weight: 700;
    line-height: 1.04;
    color: var(--color-primary);
    overflow-wrap: break-word;
  }
  .hero__rule {
    display: block;
    width: 5rem;
    height: 3px;
    margin-block: 1.75rem;
    background: var(--color-gold);
  }
  .hero__paragraph {
    max-width: 40rem;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    line-height: 1.65;
    color: var(--color-ink);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-block-start: 2.5rem;
  }
  @media (max-width: 29.99rem) {
    .hero__actions .btn {
      width: 100%;
    }
  }
  .hero__logo {
    justify-self: center;
    width: min(100%, 17rem);
  }
  @media (min-width: 40rem) {
    .hero__logo {
      width: 22rem;
    }
  }
  @media (min-width: 64rem) {
    .hero__logo {
      width: min(100%, 30rem);
    }
  }
  /* Crop to a clean circle; nothing is drawn around the logo. */
  .hero__logo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
  }
</style>
