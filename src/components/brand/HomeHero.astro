---
/**
 * Homepage hero: a single centered column of text (label, headline, gold rule,
 * paragraph and the two buttons), over a decorative banner of two overlapping
 * circles, turquoise and gold, drifting slowly toward each other ("cultures in
 * dialogue"). The lens where they overlap is the gold circle clipped by the
 * turquoise one, so it always matches the real overlap as they move.
 */
import { href, type UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-art" aria-hidden="true">
    <svg viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid slice" focusable="false">
      <defs>
        <clipPath id="hero-art-teal-clip">
          <circle class="orb-teal" cx="470" cy="300" r="240"></circle>
        </clipPath>
      </defs>
      <g class="orb orb-teal">
        <circle class="orb__fill" cx="470" cy="300" r="240"></circle>
        <circle class="orb__ring" cx="470" cy="300" r="270"></circle>
      </g>
      <g class="orb orb-gold">
        <circle class="orb__fill" cx="730" cy="300" r="240"></circle>
        <circle class="orb__ring" cx="730" cy="300" r="270"></circle>
      </g>
      <g clip-path="url(#hero-art-teal-clip)">
        <circle class="lens orb-gold" cx="730" cy="300" r="240"></circle>
      </g>
    </svg>
  </div>
  <div class="container-site hero__inner">
    <div class="hero__text">
      <p class="eyebrow hero__label">{t('home.heroEyebrow')}</p>
      <h1 id="hero-title" class="hero__title">
        {t('home.heroTitle')}
      </h1>
      <span class="hero__rule" aria-hidden="true"></span>
      <p class="hero__paragraph">{t('home.heroText')}</p>
      <div class="hero__actions">
        <a href={href('about', lang)} class="btn btn-primary">
          {t('home.heroCtaWho')}
        </a>
        <a href={href('getInvolved', lang)} class="btn btn-gold">
          {t('home.heroCtaInvolved')}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: white;
    border-block-end: 1px solid var(--color-line);
  }

  /* Decorative banner behind the text. Fills stay light so the turquoise title
     and gold-dark label keep at least 3:1 contrast even on the lens. */
  .hero-art {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .hero-art svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .orb-teal .orb__fill {
    fill: var(--color-turquoise);
    opacity: 0.08;
  }
  .orb-gold .orb__fill {
    fill: var(--color-gold);
    opacity: 0.12;
  }
  .orb__ring {
    fill: none;
    stroke-width: 1.5;
    opacity: 0.35;
  }
  .orb-teal .orb__ring {
    stroke: var(--color-turquoise);
  }
  .orb-gold .orb__ring {
    stroke: var(--color-gold);
  }
  .lens {
    fill: var(--color-gold);
    opacity: 0.12;
  }
  @media (prefers-reduced-motion: no-preference) {
    .orb-teal {
      animation: hero-drift-right 14s ease-in-out infinite alternate;
    }
    .orb-gold {
      animation: hero-drift-left 14s ease-in-out infinite alternate;
    }
  }
  @keyframes hero-drift-right {
    to {
      transform: translateX(18px);
    }
  }
  @keyframes hero-drift-left {
    to {
      transform: translateX(-18px);
    }
  }

  .hero__inner {
    padding-block: clamp(3rem, 2rem + 4vw, 6.5rem);
  }
  .hero__text {
    max-width: 56rem;
    margin-inline: auto;
    text-align: center;
  }
  .hero__label {
    margin-block-end: 1.25rem;
    /* About 22px on desktop, never below 19px (bold, so gold-dark stays legible). */
    font-size: clamp(1.1875rem, 1rem + 0.5vw, 1.375rem);
  }
  .hero__title {
    font-size: clamp(2.75rem, 1.4rem + 5.4vw, 5.5rem);
    font-weight: 700;
    line-height: 1.04;
    color: var(--color-primary);
    overflow-wrap: break-word;
  }
  .hero__rule {
    display: block;
    width: 5rem;
    height: 3px;
    margin: 1.75rem auto;
    background: var(--color-gold);
  }
  .hero__paragraph {
    max-width: 40rem;
    margin-inline: auto;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    line-height: 1.65;
    color: var(--color-ink);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.875rem;
    margin-block-start: 2.5rem;
  }
  @media (max-width: 29.99rem) {
    .hero__actions .btn {
      width: 100%;
    }
  }
</style>
