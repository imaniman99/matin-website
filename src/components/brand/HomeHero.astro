---
/**
 * Homepage hero: a single centered column of text (label, headline, gold rule,
 * paragraph and the two buttons), with two small decorative circles, turquoise
 * and gold, in opposite corners. They float gently and never touch.
 */
import { href, type UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-art" aria-hidden="true">
    <span class="hero-dot hero-dot--teal"></span>
    <span class="hero-dot hero-dot--gold"></span>
  </div>
  <div class="container-site hero__inner">
    <div class="hero__text">
      <p class="eyebrow hero__label">{t('home.heroEyebrow')}</p>
      <h1 id="hero-title" class="hero__title">
        {t('home.heroTitle')}
      </h1>
      <span class="hero__rule" aria-hidden="true"></span>
      <p class="hero__paragraph">{t('home.heroText')}</p>
      <div class="hero__actions">
        <a href={href('about', lang)} class="btn btn-primary">
          {t('home.heroCtaWho')}
        </a>
        <a href={href('getInvolved', lang)} class="btn btn-gold">
          {t('home.heroCtaInvolved')}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: white;
    border-block-end: 1px solid var(--color-line);
  }

  /* Two small decorative circles in opposite corners, never overlapping. Fills
     stay light so the text keeps its contrast where a circle sits behind it. */
  .hero-art {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .hero-dot {
    position: absolute;
    border-radius: 50%;
  }
  /* Thin ring around each circle. */
  .hero-dot::after {
    content: '';
    position: absolute;
    inset: -0.875rem;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    opacity: 0.35;
  }
  .hero-dot--teal {
    inset-block-start: 1rem;
    inset-inline-start: -2.5rem;
    width: clamp(6rem, 4.5rem + 6vw, 10.5rem);
    aspect-ratio: 1;
    color: var(--color-turquoise);
    background: color-mix(in srgb, var(--color-turquoise) 9%, transparent);
  }
  .hero-dot--gold {
    inset-block-end: -2.5rem;
    inset-inline-end: -1.5rem;
    width: clamp(5rem, 3.5rem + 5vw, 8.5rem);
    aspect-ratio: 1;
    color: var(--color-gold);
    background: color-mix(in srgb, var(--color-gold) 14%, transparent);
  }
  @media (min-width: 64rem) {
    .hero-dot--teal {
      inset-block-start: 12%;
      inset-inline-start: 5%;
    }
    .hero-dot--gold {
      inset-block-end: 16%;
      inset-inline-end: 7%;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-dot--teal {
      animation: hero-float 12s ease-in-out infinite alternate;
    }
    .hero-dot--gold {
      animation: hero-float 12s ease-in-out -6s infinite alternate-reverse;
    }
  }
  @keyframes hero-float {
    to {
      transform: translateY(12px);
    }
  }

  .hero__inner {
    padding-block: clamp(3rem, 2rem + 4vw, 6.5rem);
  }
  .hero__text {
    max-width: 56rem;
    margin-inline: auto;
    text-align: center;
  }
  .hero__label {
    margin-block-end: 1.25rem;
    /* About 22px on desktop, never below 19px (bold, so gold-dark stays legible). */
    font-size: clamp(1.1875rem, 1rem + 0.5vw, 1.375rem);
  }
  .hero__title {
    font-size: clamp(2.75rem, 1.4rem + 5.4vw, 5.5rem);
    font-weight: 700;
    line-height: 1.04;
    color: var(--color-primary);
    overflow-wrap: break-word;
  }
  .hero__rule {
    display: block;
    width: 5rem;
    height: 3px;
    margin: 1.75rem auto;
    background: var(--color-gold);
  }
  .hero__paragraph {
    max-width: 40rem;
    margin-inline: auto;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    line-height: 1.65;
    color: var(--color-ink);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.875rem;
    margin-block-start: 2.5rem;
  }
  @media (max-width: 29.99rem) {
    .hero__actions .btn {
      width: 100%;
    }
  }
</style>
