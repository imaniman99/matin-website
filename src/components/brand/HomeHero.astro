---
/**
 * Homepage hero: a full-width photo banner (Montréal skyline) right under the
 * header, with the label, headline, gold rule, paragraph and the two buttons
 * centered on it. The photo is shown as is, with no veil; the text is dark so it
 * reads on the bright sky.
 */
import { Picture } from 'astro:assets';
import banner from '@/assets/home/hero-banner.jpg';
import { href, type UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__media" aria-hidden="true">
    <Picture
      src={banner}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[640, 960, 1280]}
      sizes="100vw"
      alt=""
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="container-site hero__inner">
    <div class="hero__text">
      <p class="eyebrow hero__label">{t('home.heroEyebrow')}</p>
      <h1 id="hero-title" class="hero__title">
        {t('home.heroTitle')}
      </h1>
      <span class="hero__rule" aria-hidden="true"></span>
      <p class="hero__paragraph">{t('home.heroText')}</p>
      <div class="hero__actions">
        <a href={href('about', lang)} class="btn btn-primary">
          {t('home.heroCtaWho')}
        </a>
        <a href={href('getInvolved', lang)} class="btn btn-outline">
          {t('home.heroCtaInvolved')}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: clamp(34rem, 22rem + 30vw, 44rem);
    overflow: hidden;
    isolation: isolate;
    background: var(--color-white);
    border-block-end: 1px solid var(--color-line);
  }

  /* Full-width photo behind the text. The skyline sits in the lower middle of
     the photo, so that is the part kept in view when the sides are cropped. */
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 65%;
  }
  .hero__inner {
    padding-block: clamp(3rem, 2rem + 4vw, 5.5rem);
  }
  .hero__text {
    max-width: 56rem;
    margin-inline: auto;
    text-align: center;
  }
  .hero__label {
    margin-block-end: 1.25rem;
    /* About 28px on desktop, never below 22px. Blue: gold text would fail contrast. */
    font-size: clamp(1.375rem, 1.1rem + 0.8vw, 1.75rem);
  }
  .hero__title {
    font-size: clamp(2.75rem, 1.4rem + 5.4vw, 5.5rem);
    font-weight: 800;
    line-height: 1.04;
    color: var(--color-primary);
    overflow-wrap: break-word;
  }
  .hero__rule {
    display: block;
    width: 5rem;
    height: 3px;
    margin: 1.75rem auto;
    background: var(--color-gold);
  }
  .hero__paragraph {
    max-width: 40rem;
    margin-inline: auto;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    line-height: 1.65;
    font-weight: 600;
    color: var(--color-ink);
    /* Soft white halo so the dark letters stay readable where the paragraph
       crosses the darker buildings of the skyline. */
    text-shadow:
      0 0 3px var(--color-white),
      0 0 8px var(--color-white),
      0 0 16px color-mix(in srgb, var(--color-white) 90%, transparent);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.875rem;
    margin-block-start: 2.5rem;
  }
  @media (max-width: 29.99rem) {
    .hero__actions .btn {
      width: 100%;
    }
  }
</style>
