---
/**
 * Homepage hero: one banner, clear hierarchy, an abstract sunrise with flowing lines
 * (new beginnings, connection). No people, flags or second logo. Pure inline SVG/CSS.
 */
import { ArrowRight, Users } from '@lucide/astro';
import { href, type UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const rays = Array.from({ length: 9 }, (_, i) => -80 + i * 20);
---

<section class="hero relative isolate overflow-hidden" aria-labelledby="hero-title">
  <div class="container-site grid items-center gap-10 pt-14 pb-24 sm:pt-16 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:gap-14 lg:pt-20 lg:pb-32">
    <div class="max-w-2xl">
      <p class="hero-eyebrow">{t('home.heroEyebrow')}</p>
      <h1 id="hero-title" class="hero-title">
        {t('home.heroTitle')}
      </h1>
      <span class="hero-rule" aria-hidden="true"></span>
      <p class="hero-text">
        {t('home.heroLine1')}
        <br class="hidden sm:inline" /> {t('home.heroLine2')}
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a href="#who-we-are" class="btn btn-primary !min-h-13 !px-7 text-base">
          {t('home.heroCtaWho')}
          <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
        </a>
        <a
          href={`${href('getInvolved', lang)}#interest`}
          class="btn btn-gold !min-h-13 !px-7 text-base"
        >
          <Users size={18} aria-hidden="true" />
          {t('home.heroCtaInvolved')}
        </a>
      </div>
    </div>

    <!-- Abstract sunrise: arcs of light over flowing lines. Decorative. -->
    <div class="hero-art" aria-hidden="true">
      <svg viewBox="0 0 520 420" class="w-full">
        <defs>
          <radialGradient id="hero-sun" cx="260" cy="300" r="150" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#F7D88A"></stop>
            <stop offset="0.65" stop-color="#E7B04C"></stop>
            <stop offset="1" stop-color="#D9A23D"></stop>
          </radialGradient>
          <linearGradient id="hero-ray" x1="0" y1="1" x2="0" y2="0">
            <stop offset="0" stop-color="#D9A23D" stop-opacity="0.9"></stop>
            <stop offset="1" stop-color="#D9A23D" stop-opacity="0"></stop>
          </linearGradient>
          <clipPath id="hero-horizon">
            <rect x="0" y="0" width="520" height="300"></rect>
          </clipPath>
        </defs>
        <g class="hero-rays" clip-path="url(#hero-horizon)">
          {rays.map((deg) => (
            <path
              d="M-3 -120 L0 -270 L3 -120Z"
              fill="url(#hero-ray)"
              transform={`translate(260 300) rotate(${deg})`}
            />
          ))}
        </g>
        <g fill="none" clip-path="url(#hero-horizon)">
          <circle
            cx="260"
            cy="300"
            r="205"
            stroke="#0A5C63"
            stroke-opacity="0.18"
            stroke-width="2"
          ></circle>
          <circle
            cx="260"
            cy="300"
            r="165"
            stroke="#1F9AA0"
            stroke-opacity="0.35"
            stroke-width="2"
          ></circle>
        </g>
        <circle
          cx="260"
          cy="300"
          r="105"
          fill="url(#hero-sun)"
          clip-path="url(#hero-horizon)"
        ></circle>
        <!-- Flowing lines: many paths meeting, like conversations. -->
        <g fill="none" stroke-linecap="round">
          <path
            d="M10 300 C 120 262 190 330 300 296 S 450 262 510 290"
            stroke="#0A5C63"
            stroke-width="5"
          ></path>
          <path
            d="M10 322 C 130 290 210 352 320 318 S 460 292 510 312"
            stroke="#1F9AA0"
            stroke-width="4"
          ></path>
          <path
            d="M10 344 C 140 316 230 372 340 342 S 470 318 510 334"
            stroke="#D9A23D"
            stroke-width="3.5"
          ></path>
          <path
            d="M10 366 C 150 342 250 390 360 364 S 480 344 510 356"
            stroke="#0A5C63"
            stroke-opacity="0.55"
            stroke-width="2.5"
          ></path>
          <path
            d="M10 386 C 160 366 270 404 380 384 S 490 366 510 376"
            stroke="#1F9AA0"
            stroke-opacity="0.5"
            stroke-width="2"
          ></path>
        </g>
      </svg>
    </div>
  </div>
</section>

<style>
  .hero {
    background:
      radial-gradient(60% 70% at 85% 40%, rgb(240 203 116 / 0.28), transparent 70%),
      linear-gradient(180deg, var(--color-ivory) 0%, #f7eedd 100%);
    border-block-end: 1px solid var(--color-line);
  }
  [dir='rtl'] .hero {
    background:
      radial-gradient(60% 70% at 15% 40%, rgb(240 203 116 / 0.28), transparent 70%),
      linear-gradient(180deg, var(--color-ivory) 0%, #f7eedd 100%);
  }
  .hero-eyebrow {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold-text);
    margin-block-end: 1rem;
  }
  .hero-title {
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1.05;
  }
  .hero-rule {
    display: block;
    width: 6rem;
    height: 4px;
    margin-block: 1.5rem;
    border-radius: 4px;
    background: linear-gradient(90deg, var(--color-gold), var(--color-aqua));
  }
  .hero-text {
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    line-height: 1.75;
    color: var(--color-ink);
    max-width: 38rem;
  }
  .hero-art {
    max-width: 34rem;
    width: 100%;
    margin-inline: auto;
  }
  @media (max-width: 63.99rem) {
    .hero-art {
      max-width: 15rem;
      order: -1;
      margin-block-end: -1.5rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-rays {
      transform-origin: 260px 300px;
      animation: rays 8s ease-in-out infinite alternate;
    }
  }
  @keyframes rays {
    from {
      opacity: 0.7;
    }
    to {
      opacity: 1;
    }
  }
</style>
