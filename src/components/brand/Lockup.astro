---
/**
 * Horizontal header lockup: "Matin" | maple-leaf rule | "Institut interculturel".
 * Built in HTML/CSS so it stays crisp at small sizes (the raster circle logo does not).
 */
import MapleLeaf from './MapleLeaf.astro';
import { useTranslations } from '@/i18n/ui';
import { href, type UiLang } from '@/i18n/routes';

interface Props {
  lang: UiLang;
  /** Background the lockup sits on (the leaf is cut out of the rule with it). */
  variant?: 'white' | 'tint';
}
const { lang, variant = 'white' } = Astro.props;
const t = useTranslations(lang);
// The logo keeps its French/English wording; on Persian pages it shows the French logo.
const logoLang = lang === 'fa' ? 'fr' : lang;
const [line1, ...rest] = useTranslations(logoLang)('brand.institute').split(' ');
---

<a
  href={href('home', lang)}
  class:list={['lockup', variant === 'tint' && 'lockup--tint']}
  dir="ltr"
>
  <span class="lockup__word" lang={logoLang} dir="ltr">
    Matin
  </span>
  <span class="lockup__rule" aria-hidden="true">
    <MapleLeaf size={11} class="lockup__leaf" />
  </span>
  <span class="lockup__inst" lang={logoLang} dir="ltr">
    <span>{line1}</span>
    <span>{rest.join(' ')}</span>
  </span>
  <span class="sr-only">— {t('nav.home')}</span>
</a>

<style>
  .lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    line-height: 1;
  }
  .lockup__word {
    font-family: var(--font-brand);
    font-weight: 800;
    font-size: 2.1rem;
    letter-spacing: -0.01em;
    color: var(--color-primary);
    padding-bottom: 0.08em;
  }
  .lockup__rule {
    position: relative;
    align-self: stretch;
    width: 2px;
    margin-block: 0.2rem;
    background: var(--color-gold);
  }
  .lockup__rule :global(.lockup__leaf) {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: var(--color-gold);
    background: var(--lockup-bg, white);
    padding: 2px 0;
    width: 13px;
    height: 15px;
  }
  .lockup__inst {
    display: flex;
    flex-direction: column;
    gap: 0.22rem;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--color-ink);
  }
  .lockup--tint {
    --lockup-bg: var(--color-tint);
  }
</style>
