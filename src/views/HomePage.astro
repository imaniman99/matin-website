---
import { Image } from 'astro:assets';
import { ArrowRight, HandHeart, Heart } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SunriseHero from '@/components/brand/SunriseHero.astro';
import WaveDivider from '@/components/brand/WaveDivider.astro';
import LeafRule from '@/components/brand/LeafRule.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import StatStrip from '@/components/ui/StatStrip.astro';
import Testimonials from '@/components/ui/Testimonials.astro';
import EventCard from '@/components/content/EventCard.astro';
import ExpireEvents from '@/components/content/ExpireEvents.astro';
import ProgramCard from '@/components/content/ProgramCard.astro';
import PostCard from '@/components/content/PostCard.astro';
import NewsletterForm from '@/components/forms/NewsletterForm.astro';
import logoCircle from '@/assets/brand/logo-circle.png';
import { alternatesFor, path, type Lang } from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import {
  getSettings,
  getUpcomingEvents,
  getPrograms,
  getNews,
  getTestimonials,
  getPartners,
} from '@/lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const [settings, upcoming, programs, posts, testimonials, partners] = await Promise.all([
  getSettings(),
  getUpcomingEvents(3),
  getPrograms(),
  getNews(3),
  getTestimonials(),
  getPartners(),
]);
---

<BaseLayout
  lang={lang}
  alternates={alternatesFor('home')}
  footerNewsletter={false}
  searchable={false}
  footerWaveFrom="var(--color-primary)"
>
  <!-- Shown when Brevo's confirmation link brings the visitor back (?infolettre=confirmee). -->
  <div class="container-site" data-newsletter-confirmed hidden>
    <p
      class="mt-4 rounded-2xl bg-aqua-light p-4 text-center font-semibold text-primary-dark"
      role="status"
    >
      {t('newsletter.confirmed')}
    </p>
  </div>
  <SunriseHero lang={lang} />

  <!-- About teaser -->
  <section class="bg-white py-20 sm:py-24" aria-labelledby="about-title">
    <div class="container-site grid items-center gap-14 lg:grid-cols-2">
      <div class="relative mx-auto w-full max-w-md" data-reveal>
        <div
          class="absolute inset-[-8%] -z-0 rounded-full bg-[radial-gradient(circle,rgb(108_207_227/0.35),transparent_65%)]"
          aria-hidden="true"
        ></div>
        <Image
          src={logoCircle}
          alt={t('meta.siteName')}
          widths={[320, 480, 640]}
          sizes="(min-width: 1024px) 28rem, 80vw"
          class="relative mx-auto w-full max-w-[26rem] drop-shadow-[0_24px_40px_rgba(6,34,56,0.22)]"
          loading="lazy"
        />
      </div>
      <div data-reveal style="--reveal-delay:120ms">
        <p class="eyebrow mb-3">{t('home.aboutEyebrow')}</p>
        <h2 id="about-title" class="section-title">
          {t('home.aboutTitle')}
        </h2>
        <LeafRule class="mt-5 w-40" />
        <p class="mt-6 text-lg">{pick(settings.mission, lang)}</p>
        <p class="script mt-6 text-4xl text-primary">{t('brand.secondaryTagline')}</p>
        <a href={path('about', lang)} class="link-arrow mt-8">
          {t('home.aboutLink')}
          <ArrowRight size={18} aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <WaveDivider from="white" to="var(--color-aqua-light)" />

  <!-- Upcoming events -->
  <section class="bg-aqua-light pt-10 pb-20 sm:pb-24" aria-labelledby="events-title">
    <div class="container-site">
      <SectionHeader
        id="events-title"
        eyebrow={t('home.eventsEyebrow')}
        title={t('home.eventsTitle')}
        link={{ href: path('events', lang), label: t('home.eventsAll') }}
      />
      <div>
        {upcoming.length > 0 && (
          <ul class="grid gap-8 md:grid-cols-2 lg:grid-cols-3" data-upcoming-list>
            {upcoming.map((event, i) => (
              <li data-reveal style={`--reveal-delay:${i * 100}ms`}>
                <EventCard event={event} lang={lang} />
              </li>
            ))}
          </ul>
        )}
        <p
          class="card p-8 text-center text-lg text-muted"
          data-upcoming-empty
          hidden={upcoming.length > 0}
        >
          {t('home.eventsEmpty')}
        </p>
      </div>
    </div>
  </section>
  <ExpireEvents />

  <WaveDivider from="var(--color-aqua-light)" to="white" flip />

  <!-- Programs -->
  <section class="bg-white pt-10 pb-20 sm:pb-24" aria-labelledby="programs-title">
    <div class="container-site">
      <SectionHeader
        id="programs-title"
        eyebrow={t('home.programsEyebrow')}
        title={t('home.programsTitle')}
        lede={t('home.programsLede')}
        link={{ href: path('programs', lang), label: t('home.programsAll') }}
      />
      <ul class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {programs.slice(0, 6).map((program, i) => (
          <li data-reveal style={`--reveal-delay:${i * 100}ms`}>
            <ProgramCard program={program} lang={lang} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <StatStrip lang={lang} impact={settings.impact} />

  <!-- Latest news -->
  <section class="bg-cream py-20 sm:py-24" aria-labelledby="news-title">
    <div class="container-site">
      <SectionHeader
        id="news-title"
        eyebrow={t('home.newsEyebrow')}
        title={t('home.newsTitle')}
        link={{ href: path('news', lang), label: t('home.newsAll') }}
      />
      <ul class="grid gap-10 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post, i) => (
          <li data-reveal style={`--reveal-delay:${i * 100}ms`}>
            <PostCard post={post} lang={lang} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <WaveDivider from="var(--color-cream)" to="white" />

  <!-- Testimonials -->
  {testimonials.length > 0 && (
    <section class="bg-white pt-8 pb-20 sm:pb-24">
      <div class="container-site">
        <SectionHeader
          id="testimonials-title"
          eyebrow={t('home.testimonialsEyebrow')}
          title={t('home.testimonialsTitle')}
          align="center"
        />
        <Testimonials items={testimonials} lang={lang} labelledBy="testimonials-title" />
      </div>
    </section>
  )}

  <!-- Partners -->
  {partners.length > 0 && (
    <section class="border-y border-line/60 bg-white py-14" aria-labelledby="partners-title">
      <div class="container-site">
        <h2 id="partners-title" class="eyebrow mb-8 text-center !font-sans">
          {t('home.partnersTitle')}
        </h2>
        <ul class="flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
          {partners.map((p) => {
            const inner = p.data.logo ? (
              <Image
                src={p.data.logo}
                alt={p.data.name}
                height={56}
                class="h-14 w-auto object-contain opacity-80 grayscale transition hover:opacity-100 hover:grayscale-0"
              />
            ) : (
              <span class="grid h-14 min-w-36 place-items-center rounded-xl border border-dashed border-primary/25 px-4 text-sm font-semibold text-muted">
                {p.data.name}
              </span>
            );
            return (
              <li>
                {p.data.url ? (
                  <a href={p.data.url} target="_blank" rel="noopener noreferrer" class="block">
                    {inner}
                    <span class="sr-only">{t('a11y.externalLink')}</span>
                  </a>
                ) : (
                  inner
                )}
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  <!-- Newsletter -->
  <section class="relative bg-aqua-light py-20" aria-labelledby="newsletter-title">
    <div class="container-site">
      <div
        class="card mx-auto grid max-w-5xl items-center gap-8 p-8 sm:p-12 lg:grid-cols-[1fr_1.2fr]"
        data-reveal
      >
        <div>
          <p class="script text-4xl text-teal">{t('brand.tagline')}</p>
          <h2 id="newsletter-title" class="mt-2 text-3xl font-bold">
            {t('newsletter.title')}
          </h2>
          <p class="mt-3 text-muted">{t('newsletter.text')}</p>
        </div>
        <NewsletterForm lang={lang} id="home-newsletter" />
      </div>
    </div>
  </section>

  <WaveDivider from="var(--color-aqua-light)" to="var(--color-primary)" />

  <!-- Final call to action -->
  <section
    class="on-dark relative isolate overflow-hidden bg-primary pt-10 pb-24 text-center text-white"
    aria-labelledby="cta-title"
  >
    <div class="cta-glow absolute inset-0 -z-10" aria-hidden="true"></div>
    <svg
      class="absolute bottom-0 left-1/2 -z-10 w-[900px] max-w-none -translate-x-1/2 opacity-40"
      viewBox="0 0 900 450"
      aria-hidden="true"
    >
      <defs>
        <linearGradient id="cta-ray" x1="0" y1="1" x2="0" y2="0">
          <stop offset="0" stop-color="#F2CD78" stop-opacity="0.8" />
          <stop offset="1" stop-color="#F2CD78" stop-opacity="0" />
        </linearGradient>
      </defs>
      {Array.from({ length: 11 }, (_, i) => (
        <path
          d="M-3 -60 L0 -420 L3 -60Z"
          fill="url(#cta-ray)"
          transform={`translate(450 450) rotate(${-75 + i * 15})`}
        />
      ))}
    </svg>
    <div class="container-site max-w-3xl" data-reveal>
      <LeafRule light class="mx-auto mb-6 w-40" />
      <h2 id="cta-title" class="text-4xl font-bold text-white sm:text-5xl">
        {t('home.ctaTitle')}
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-lg text-aqua-light">{t('home.ctaText')}</p>
      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <a href={path('getInvolved', lang)} class="btn btn-ghost-light">
          <HandHeart size={18} aria-hidden="true" />
          {t('home.ctaInvolved')}
        </a>
        <a href={settings.donateUrl} class="btn btn-gold" rel="noopener">
          <Heart size={18} aria-hidden="true" />
          {t('home.ctaDonate')}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  if (new URL(location.href).searchParams.get('infolettre') === 'confirmee') {
    document.querySelector<HTMLElement>('[data-newsletter-confirmed]')!.hidden = false;
  }
</script>

<style>
  .cta-glow {
    background:
      radial-gradient(42% 52% at 50% 62%, rgb(242 205 120 / 0.22), transparent 100%),
      radial-gradient(35% 60% at 0% 0%, rgb(108 207 227 / 0.16), transparent 70%);
  }
</style>
