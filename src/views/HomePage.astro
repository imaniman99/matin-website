---
/**
 * Homepage (French, English and Persian). Shows only real content: events and news
 * sections fall back to short, welcoming empty states until entries exist.
 */
import {
  ArrowRight,
  BookOpen,
  Eye,
  HeartHandshake,
  MessagesSquare,
  Palette,
  Send,
  Target,
} from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SunriseHero from '@/components/brand/SunriseHero.astro';
import LeafRule from '@/components/brand/LeafRule.astro';
import EventCardWide from '@/components/content/EventCardWide.astro';
import ExpireEvents from '@/components/content/ExpireEvents.astro';
import PostCard from '@/components/content/PostCard.astro';
import NewsletterForm from '@/components/forms/NewsletterForm.astro';
import { href, siteAlternates, type UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { forLang, getNews, getPastEvents, getSettings, getUpcomingEvents } from '@/lib/content';
import { newsCategories } from '@/lib/taxonomy';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const [settings, upcomingAll, pastAll, postsAll] = await Promise.all([
  getSettings(),
  getUpcomingEvents(),
  getPastEvents(),
  getNews(),
]);
// Persian pages only list entries whose Persian translation has been reviewed.
const upcoming = forLang(upcomingAll, lang).slice(0, 4);
const past = forLang(pastAll, lang).slice(0, 2);
const posts = forLang(postsAll, lang);
const newsTabs = newsCategories.map((c) => ({
  id: c,
  label: t(`newsCategories.${c}`),
  posts: posts.filter((p) => p.data.category === c).slice(0, 2),
}));
const anyNews = newsTabs.some((tab) => tab.posts.length);

const aboutHref = href('about', lang);
const whoCards = [
  { id: 'mission', label: t('nav.mission'), icon: Target },
  { id: 'vision', label: t('nav.vision'), icon: Eye },
  { id: 'values', label: t('nav.values'), icon: HeartHandshake },
];
const areas = [
  { title: t('home.area1Title'), text: t('home.area1Text'), icon: MessagesSquare },
  { title: t('home.area2Title'), text: t('home.area2Text'), icon: Palette },
  { title: t('home.area3Title'), text: t('home.area3Text'), icon: BookOpen },
];
const interestHref = `${href('getInvolved', lang)}#interest`;
---

<BaseLayout
  lang={lang}
  alternates={siteAlternates('home')}
  footerNewsletter={false}
  searchable={false}
  footerWaveFrom="var(--color-primary)"
>
  <!-- Shown when Brevo's confirmation link brings the visitor back (?infolettre=confirmee). -->
  <div class="container-site" data-newsletter-confirmed hidden>
    <p
      class="mt-4 rounded-2xl bg-sand p-4 text-center font-semibold text-primary-dark"
      role="status"
    >
      {t('newsletter.confirmed')}
    </p>
  </div>

  <SunriseHero lang={lang} />

  <!-- Who we are -->
  <section id="who-we-are" class="scroll-mt-24 bg-white py-20 sm:py-24" aria-labelledby="who-title">
    <div class="container-site">
      <div class="max-w-3xl">
        <h2 id="who-title" class="section-title">
          {t('home.whoTitle')}
        </h2>
        <LeafRule class="mt-5 w-40" />
        <p class="mt-7 text-lg leading-relaxed text-ink sm:text-xl">{t('home.whoText')}</p>
      </div>
      <nav aria-label={t('home.whoCardsLabel')} class="mt-12">
        <ul class="grid gap-5 sm:grid-cols-3">
          {whoCards.map((c) => (
            <li>
              <a href={`${aboutHref}#${c.id}`} class="who-card group">
                <span class="who-card__icon">
                  <c.icon size={24} stroke-width={1.75} aria-hidden="true" />
                </span>
                <span class="flex-1 text-xl font-bold text-primary">{c.label}</span>
                <ArrowRight
                  size={20}
                  class="flip-rtl shrink-0 text-gold-text transition-transform group-hover:translate-x-1"
                  aria-hidden="true"
                />
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  <!-- Areas of work -->
  <section class="bg-cream py-20 sm:py-24" aria-labelledby="areas-title">
    <div class="container-site">
      <div class="mb-12 max-w-3xl">
        <p class="eyebrow-lg">{t('home.areasEyebrow')}</p>
        <h2 id="areas-title" class="section-title">
          {t('home.areasTitle')}
        </h2>
        <LeafRule class="mt-5 w-40" />
        <p class="mt-6 text-lg text-ink sm:text-xl">{t('home.areasLede')}</p>
      </div>
      <ul class="grid gap-6 lg:grid-cols-3">
        {areas.map((a) => (
          <li>
            <a href={href('programs', lang)} class="area-card group">
              <span class="area-card__icon">
                <a.icon size={26} stroke-width={1.6} aria-hidden="true" />
              </span>
              <h3 class="text-2xl leading-snug font-bold text-primary">{a.title}</h3>
              <p class="text-[1.07rem] leading-relaxed text-ink/85">{a.text}</p>
              <span class="mt-auto inline-flex items-center gap-2 pt-2 font-semibold text-teal">
                {t('common.learnMore')}
                <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Events -->
  <section class="bg-sand py-20 sm:py-24" aria-labelledby="events-title">
    <div class="container-site">
      <div class="mb-10 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 id="events-title" class="section-title">
            {t('home.eventsTitle')}
          </h2>
          <LeafRule class="mt-5 w-40" />
        </div>
        <a href={href('events', lang)} class="btn btn-outline self-start bg-white sm:self-auto">
          {t('home.eventsAll')}
          <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
        </a>
      </div>

      <h3 class="subsection-title">{t('home.eventsUpcoming')}</h3>
      <div>
        {upcoming.length > 0 && (
          <ul class="grid gap-6 lg:grid-cols-2" data-upcoming-list>
            {upcoming.map((event) => (
              <li>
                <EventCardWide event={event} lang={lang} />
              </li>
            ))}
          </ul>
        )}
        <p class="empty-line" data-upcoming-empty hidden={upcoming.length > 0}>
          {t('home.eventsEmpty')}
        </p>
      </div>

      {past.length > 0 && (
        <div class="mt-14">
          <h3 class="subsection-title">{t('home.eventsPast')}</h3>
          <ul class="grid gap-6 lg:grid-cols-2">
            {past.map((event) => (
              <li>
                <EventCardWide event={event} lang={lang} past />
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
  <ExpireEvents />

  <!-- News -->
  <section class="bg-white py-20 sm:py-24" aria-labelledby="news-title">
    <div class="container-site">
      <div class="mb-10 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 id="news-title" class="section-title">
            {t('home.newsTitle')}
          </h2>
          <LeafRule class="mt-5 w-40" />
        </div>
        {anyNews && (
          <a href={href('news', lang)} class="link-arrow">
            {t('home.newsAll')}
            <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
          </a>
        )}
      </div>

      {anyNews ? (
        <div data-tabs>
          <div role="tablist" aria-label={t('home.newsTabs')} class="tablist">
            {newsTabs.map((tab, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${tab.id}`}
                aria-controls={`panel-${tab.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                class="tab"
              >
                {tab.label}
              </button>
            ))}
          </div>
          {newsTabs.map((tab, i) => (
            <div
              role="tabpanel"
              id={`panel-${tab.id}`}
              aria-labelledby={`tab-${tab.id}`}
              tabindex="0"
              hidden={i > 0}
              class="pt-8"
            >
              {tab.posts.length > 0 ? (
                <ul class="grid gap-10 md:grid-cols-2">
                  {tab.posts.map((post) => (
                    <li>
                      <PostCard post={post} lang={lang} />
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="empty-line">{t('home.newsEmptyCategory')}</p>
              )}
            </div>
          ))}
        </div>
      ) : (
        <p class="empty-line">{t('home.newsEmpty')}</p>
      )}
    </div>
  </section>

  <!-- Get involved -->
  <section class="bg-cream py-20 sm:py-24" aria-labelledby="involved-title">
    <div class="container-site">
      <div class="involved">
        <div>
          <p class="eyebrow-lg">{t('home.involvedEyebrow')}</p>
          <h2 id="involved-title" class="section-title">
            {t('home.involvedTitle')}
          </h2>
          <LeafRule class="mt-5 w-40" />
        </div>
        <div>
          <p class="text-lg leading-relaxed text-ink sm:text-xl">{t('home.involvedText')}</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={interestHref} class="btn btn-primary !min-h-13 !px-7 text-base">
              {t('home.involvedPrimary')}
              <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
            </a>
            {settings.formsEnabled && (
              <a href="#newsletter" class="btn btn-outline !min-h-13 bg-white !px-7 text-base">
                {t('home.involvedSecondary')}
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section id="newsletter" class="scroll-mt-24 bg-white py-20" aria-labelledby="newsletter-title">
    <div class="container-site">
      <div class="newsletter-card">
        <div>
          <p class="eyebrow-lg">{t('newsletter.eyebrow')}</p>
          <h2 id="newsletter-title" class="text-3xl font-bold sm:text-4xl">
            {t('newsletter.title')}
          </h2>
          <p class="mt-4 text-lg text-ink">{t('newsletter.text')}</p>
        </div>
        <NewsletterForm lang={lang} id="home-newsletter" />
      </div>
    </div>
  </section>

  <!-- Interest call to action -->
  <section
    class="on-dark relative isolate overflow-hidden bg-primary py-20 text-center text-white sm:py-24"
    aria-labelledby="cta-title"
  >
    <div class="cta-glow absolute inset-0 -z-10" aria-hidden="true"></div>
    <svg
      class="absolute bottom-0 left-1/2 -z-10 w-[760px] max-w-none -translate-x-1/2 opacity-20"
      viewBox="0 0 760 300"
      aria-hidden="true"
    >
      {Array.from({ length: 5 }, (_, i) => (
        <path
          d="M-1.5 -20 L0 -110 L1.5 -20Z"
          fill="#F0CB74"
          transform={`translate(380 300) rotate(${-40 + i * 20})`}
        />
      ))}
    </svg>
    <div class="container-site max-w-3xl">
      <LeafRule light class="mx-auto mb-6 w-40" />
      <h2 id="cta-title" class="text-4xl font-bold !text-white sm:text-5xl">
        {t('home.ctaTitle')}
      </h2>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-white/90 sm:text-xl">
        {t('home.ctaText')}
      </p>
      <a href={interestHref} class="btn btn-gold mt-9 !min-h-13 !px-8 text-base">
        <Send size={18} class="flip-rtl" aria-hidden="true" />
        {t('home.ctaButton')}
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  if (new URL(location.href).searchParams.get('infolettre') === 'confirmee') {
    const note = document.querySelector<HTMLElement>('[data-newsletter-confirmed]');
    if (note) note.hidden = false;
  }

  // Accessible tabs (WAI-ARIA pattern): arrow keys move between tabs (mirrored in RTL).
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls')!);
        if (panel) panel.hidden = !on;
      });
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const rtl = getComputedStyle(root).direction === 'rtl';
        const next = rtl ? 'ArrowLeft' : 'ArrowRight';
        const prev = rtl ? 'ArrowRight' : 'ArrowLeft';
        let j = -1;
        if (e.key === next) j = (i + 1) % tabs.length;
        if (e.key === prev) j = (i - 1 + tabs.length) % tabs.length;
        if (e.key === 'Home') j = 0;
        if (e.key === 'End') j = tabs.length - 1;
        if (j >= 0) {
          e.preventDefault();
          select(tabs[j], true);
        }
      });
    });
  });
</script>

<style>
  .eyebrow-lg {
    margin-block-end: 0.75rem;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-gold-text);
  }
  .subsection-title {
    margin-block-end: 1.25rem;
    font-family: var(--font-sans);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-primary-dark);
  }
  .empty-line {
    padding: 1.25rem 1.5rem;
    border-radius: 1rem;
    font-size: 1.1rem;
    background: white;
    color: var(--color-ink);
    border-inline-start: 4px solid var(--color-gold);
    box-shadow: var(--shadow-soft);
  }
  .who-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
    padding: 1.25rem 1.4rem;
    border-radius: var(--radius-card);
    background: var(--color-ivory);
    border: 1.5px solid var(--color-line);
    text-decoration: none;
    transition:
      border-color 0.2s,
      box-shadow 0.2s,
      transform 0.2s;
  }
  .who-card:hover {
    border-color: var(--color-gold);
    box-shadow: var(--shadow-soft);
    transform: translateY(-2px);
  }
  .who-card__icon,
  .area-card__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    color: var(--color-primary);
    background: white;
    border: 1.5px solid color-mix(in srgb, var(--color-gold) 70%, transparent);
  }
  .area-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
    padding: 2rem;
    border-radius: var(--radius-card);
    background: white;
    border: 1px solid var(--color-line);
    border-block-start: 4px solid var(--color-gold);
    text-decoration: none;
    box-shadow: var(--shadow-soft);
    transition:
      box-shadow 0.2s,
      transform 0.2s;
  }
  .area-card:hover {
    box-shadow: var(--shadow-lift);
    transform: translateY(-3px);
  }
  .tablist {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    border-block-end: 2px solid var(--color-line);
  }
  .tab {
    position: relative;
    min-height: 3rem;
    padding: 0.6rem 1.2rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-muted);
    cursor: pointer;
    border-radius: 0.75rem 0.75rem 0 0;
  }
  .tab:hover {
    color: var(--color-primary);
    background: var(--color-ivory);
  }
  .tab[aria-selected='true'] {
    color: var(--color-primary);
  }
  .tab[aria-selected='true']::after {
    content: '';
    position: absolute;
    inset-inline: 0.6rem;
    bottom: -2px;
    height: 3px;
    border-radius: 3px;
    background: var(--color-gold);
  }
  .involved {
    display: grid;
    gap: 2rem;
    padding: 2.5rem;
    border-radius: var(--radius-card);
    background: white;
    border: 1px solid var(--color-line);
    border-inline-start: 6px solid var(--color-primary);
  }
  @media (min-width: 64rem) {
    .involved {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      align-items: center;
      gap: 4rem;
      padding: 3.5rem;
    }
  }
  .newsletter-card {
    display: grid;
    gap: 2rem;
    max-width: 68rem;
    margin-inline: auto;
    padding: 2.5rem;
    border-radius: var(--radius-card);
    background: var(--color-ivory);
    border: 1.5px solid var(--color-line);
    color: var(--color-primary-dark);
  }
  @media (min-width: 64rem) {
    .newsletter-card {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      align-items: center;
      gap: 3.5rem;
      padding: 3rem;
    }
  }
  .cta-glow {
    background:
      radial-gradient(40% 70% at 0% 0%, rgb(31 154 160 / 0.3), transparent 70%),
      radial-gradient(40% 70% at 100% 100%, rgb(31 154 160 / 0.22), transparent 70%);
  }
</style>
