---
import { Check, ExternalLink, Heart, HandHeart, Handshake, IdCard, Mail } from '@lucide/astro';
import PageLayout from '@/layouts/PageLayout.astro';
import WaveDivider from '@/components/brand/WaveDivider.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import VolunteerForm from '@/components/forms/VolunteerForm.astro';
import { alternatesFor, path, type Lang } from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import { getSettings, getSingleton } from '@/lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const [settings, inv] = await Promise.all([getSettings(), getSingleton('involvement')]);
const money = new Intl.NumberFormat(lang === 'fr' ? 'fr-CA' : 'en-CA', {
  style: 'currency',
  currency: 'CAD',
  maximumFractionDigits: 0,
});
// Anchors are translated too, so French URLs stay fully French.
const ids =
  lang === 'fr'
    ? { membership: 'adhesion', volunteer: 'benevolat', partners: 'partenariats', donate: 'don' }
    : {
        membership: 'membership',
        volunteer: 'volunteer',
        partners: 'partnerships',
        donate: 'donate',
      };
const jump = [
  { id: ids.membership, label: t('involved.membership'), icon: IdCard },
  { id: ids.volunteer, label: t('involved.volunteer'), icon: HandHeart },
  { id: ids.partners, label: t('involved.partners'), icon: Handshake },
  { id: ids.donate, label: t('involved.donate'), icon: Heart },
];
---

<PageLayout
  lang={lang}
  title={t('involved.title')}
  lede={t('involved.lede')}
  alternates={alternatesFor('getInvolved')}
  footerWaveFrom="var(--color-primary)"
>
  <nav slot="hero" aria-label={t('involved.jumpTo')} class="mt-8">
    <ul class="flex flex-wrap gap-2">
      {jump.map((j) => (
        <li>
          <a href={`#${j.id}`} class="jump">
            <j.icon size={17} aria-hidden="true" />
            {j.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- Membership -->
  <section id={ids.membership} class="container-site pt-6 pb-20" aria-labelledby="membership-title">
    <SectionHeader
      id="membership-title"
      title={t('involved.membership')}
      lede={pick(inv.membershipIntro, lang)}
    />
    <ul class="grid gap-6 md:grid-cols-3">
      {inv.tiers.map((tier) => (
        <li
          class:list={[
            'card flex flex-col p-8',
            tier.featured && 'ring-2 ring-gold md:-translate-y-3 shadow-lift',
          ]}
        >
          <h3 class="text-2xl font-bold">{pick(tier.name, lang)}</h3>
          <p class="mt-3 mb-6">
            <span class="font-display text-4xl font-bold [overflow-wrap:anywhere] text-primary">
              {pick(tier.price, lang)}
            </span>
            <span class="text-sm text-muted"> {t('involved.perYear')}</span>
          </p>
          <ul class="mb-8 space-y-2.5">
            {tier.benefits.map((b) => (
              <li class="flex gap-2.5">
                <Check size={20} class="mt-0.5 shrink-0 text-teal" aria-hidden="true" />
                <span>{pick(b, lang)}</span>
              </li>
            ))}
          </ul>
          {inv.membershipUrl && (
            <a
              href={inv.membershipUrl}
              class:list={['btn mt-auto', tier.featured ? 'btn-gold' : 'btn-outline']}
              target="_blank"
              rel="noopener noreferrer"
            >
              {t('involved.becomeMember')}
              <span class="sr-only">
                — {pick(tier.name, lang)} {t('a11y.externalLink')}
              </span>
            </a>
          )}
        </li>
      ))}
    </ul>
  </section>

  <WaveDivider from="white" to="var(--color-aqua-light)" />

  <!-- Volunteer -->
  <section id={ids.volunteer} class="bg-aqua-light pt-8 pb-20" aria-labelledby="volunteer-title">
    <div class="container-site grid gap-12 lg:grid-cols-[1fr_1.15fr]">
      <div>
        <SectionHeader
          id="volunteer-title"
          title={t('involved.volunteer')}
          lede={pick(inv.volunteerIntro, lang)}
        />
        <ul class="space-y-4">
          {inv.roles.map((r) => (
            <li class="card p-6">
              <h3 class="mb-1 text-xl font-bold">{pick(r.title, lang)}</h3>
              <p class="text-muted">{pick(r.text, lang)}</p>
            </li>
          ))}
        </ul>
      </div>
      <div class="card self-start p-6 sm:p-10">
        <h3 class="mb-6 text-2xl font-bold">{t('involved.volunteerForm')}</h3>
        <VolunteerForm lang={lang} roles={inv.roles.map((r) => pick(r.title, lang)!)} />
      </div>
    </div>
  </section>

  <WaveDivider from="var(--color-aqua-light)" to="white" flip />

  <!-- Partnerships -->
  <section id={ids.partners} class="container-site pt-8 pb-20" aria-labelledby="partners-title">
    <div class="card grid items-center gap-8 p-8 sm:p-12 md:grid-cols-[1fr_auto]">
      <div>
        <h2 id="partners-title" class="section-title mb-4">
          {t('involved.partners')}
        </h2>
        <p class="max-w-2xl text-lg text-muted">{pick(inv.partnersText, lang)}</p>
      </div>
      <a href={path('contact', lang)} class="btn btn-primary">
        <Mail size={18} aria-hidden="true" />
        {t('involved.partnersCta')}
      </a>
    </div>
  </section>

  <WaveDivider from="white" to="var(--color-primary)" />

  <!-- Donate -->
  <section
    id={ids.donate}
    class="on-dark relative isolate overflow-hidden bg-primary pt-8 pb-24 text-white"
    aria-labelledby="donate-title"
  >
    <div class="donate-glow absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="container-site grid gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <h2 id="donate-title" class="section-title mb-5 !text-white">
          {t('involved.donate')}
        </h2>
        <p class="mb-8 text-lg text-aqua-light">{pick(inv.donateText, lang)}</p>
        <a href={settings.donateUrl} class="btn btn-gold" target="_blank" rel="noopener noreferrer">
          <Heart size={18} aria-hidden="true" />
          {t('involved.donateCta')}
          <ExternalLink size={16} aria-hidden="true" />
          <span class="sr-only">{t('a11y.externalLink')}</span>
        </a>
        {settings.charityNumber && (
          <p class="mt-6 text-sm text-white/80">
            {t('involved.taxReceipt', { number: settings.charityNumber })}
          </p>
        )}
      </div>
      <div>
        <h3 class="mb-5 font-sans text-sm font-bold tracking-[0.18em] text-gold-light uppercase">
          {t('involved.impactTitle')}
        </h3>
        <ul class="space-y-3">
          {inv.impactExamples.map((ex) => (
            <li class="flex items-center gap-5 rounded-2xl bg-white/[0.07] p-5 ring-1 ring-white/10">
              <span class="w-24 shrink-0 font-display text-3xl font-bold text-gold-light">
                {money.format(ex.amount)}
              </span>
              <span class="text-white/90">{pick(ex.text, lang)}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .jump {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding: 0.4rem 1.1rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-primary);
    background: white;
    text-decoration: none;
    box-shadow: var(--shadow-soft);
  }
  .jump:hover {
    background: var(--color-primary);
    color: white;
  }
  .donate-glow {
    background:
      radial-gradient(50% 70% at 85% 60%, rgb(242 205 120 / 0.2), transparent 70%),
      radial-gradient(35% 60% at 0% 0%, rgb(108 207 227 / 0.16), transparent 70%);
  }
</style>
