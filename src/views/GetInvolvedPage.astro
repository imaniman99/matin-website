---
/**
 * Get Involved. French/English: interest form, volunteering and partnerships.
 * Persian: introduction and interest form (the sections that have Persian text).
 * Membership and donations are not offered (Matin hasn't opened them).
 */
import { HandHeart, Handshake, Mail, Send } from '@lucide/astro';
import PageLayout from '@/layouts/PageLayout.astro';
import WaveDivider from '@/components/brand/WaveDivider.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import InterestForm from '@/components/forms/InterestForm.astro';
import VolunteerForm from '@/components/forms/VolunteerForm.astro';
import { href, siteAlternates, type UiLang } from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import { getSingleton } from '@/lib/content';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const inv = await getSingleton('involvement');
const full = lang !== 'fa';
// "interest" stays the same in every language: the homepage links to #interest.
const ids =
  lang === 'fr'
    ? { volunteer: 'benevolat', partners: 'partenariats' }
    : { volunteer: 'volunteer', partners: 'partnerships' };
const jump = [
  { id: 'interest', label: t('involved.interest'), icon: Send },
  ...(full
    ? [
        { id: ids.volunteer, label: t('involved.volunteer'), icon: HandHeart },
        { id: ids.partners, label: t('involved.partners'), icon: Handshake },
      ]
    : []),
];
---

<PageLayout
  lang={lang}
  title={t('involved.title')}
  lede={t('involved.lede')}
  alternates={siteAlternates('getInvolved')}
>
  {jump.length > 1 && (
    <nav slot="hero" aria-label={t('involved.jumpTo')} class="mt-8">
      <ul class="flex flex-wrap gap-2">
        {jump.map((j) => (
          <li>
            <a href={`#${j.id}`} class="jump">
              <j.icon size={17} aria-hidden="true" />
              {j.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  <!-- Interest -->
  <section id="interest" class="scroll-mt-24 pt-6 pb-20" aria-labelledby="interest-title">
    <div class="container-site grid gap-10 lg:grid-cols-[1fr_1.3fr]">
      <div>
        <SectionHeader id="interest-title" title={t('interest.title')} />
        <p class="-mt-4 text-lg leading-relaxed text-ink">{t('interest.intro')}</p>
      </div>
      <div class="card self-start p-6 sm:p-10">
        <InterestForm lang={lang} />
      </div>
    </div>
  </section>

  {full && (
    <>
      <WaveDivider from="var(--color-ivory)" to="var(--color-sand)" />

      <!-- Volunteer -->
      <section id={ids.volunteer} class="bg-sand pt-8 pb-20" aria-labelledby="volunteer-title">
        <div class="container-site grid gap-12 lg:grid-cols-[1fr_1.15fr]">
          <div>
            <SectionHeader
              id="volunteer-title"
              title={t('involved.volunteer')}
              lede={pick(inv.volunteerIntro, lang)}
            />
            <ul class="space-y-4">
              {inv.roles.map((r) => (
                <li class="card p-6">
                  <h3 class="mb-1 text-xl font-bold">{pick(r.title, lang)}</h3>
                  <p class="text-muted">{pick(r.text, lang)}</p>
                </li>
              ))}
            </ul>
          </div>
          <div class="card self-start p-6 sm:p-10">
            <h3 class="mb-6 text-2xl font-bold">{t('involved.volunteerForm')}</h3>
            <VolunteerForm lang={lang} roles={inv.roles.map((r) => pick(r.title, lang)!)} />
          </div>
        </div>
      </section>

      <WaveDivider from="var(--color-sand)" to="var(--color-ivory)" flip />

      <!-- Partnerships -->
      <section id={ids.partners} class="container-site pt-8 pb-20" aria-labelledby="partners-title">
        <div class="card grid items-center gap-8 p-8 sm:p-12 md:grid-cols-[1fr_auto]">
          <div>
            <h2 id="partners-title" class="section-title mb-4">
              {t('involved.partners')}
            </h2>
            <p class="max-w-2xl text-lg text-muted">{pick(inv.partnersText, lang)}</p>
          </div>
          <a href={href('contact', lang)} class="btn btn-primary">
            <Mail size={18} aria-hidden="true" />
            {t('involved.partnersCta')}
          </a>
        </div>
      </section>
    </>
  )}
</PageLayout>

<style>
  .jump {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding: 0.4rem 1.1rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-primary);
    background: white;
    text-decoration: none;
    box-shadow: var(--shadow-soft);
  }
  .jump:hover {
    background: var(--color-primary);
    color: white;
  }
</style>
