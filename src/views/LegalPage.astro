---
import PageLayout from '@/layouts/PageLayout.astro';
import Prose from '@/components/ui/Prose.astro';
import { alternatesFor, type Lang } from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import { getLegal, getSettings, renderMarkdown } from '@/lib/content';
import { formatDate } from '@/lib/dates';

interface Props {
  lang: Lang;
  page: 'privacy' | 'terms' | 'accessibility';
}
const { lang, page } = Astro.props;
const t = useTranslations(lang);
const [doc, settings] = await Promise.all([getLegal(page), getSettings()]);
const officer = settings.privacyOfficer;

// {{privacyOfficer}} in the text is replaced by the person in charge (Law 25),
// so the policy always shows the details from the site settings.
const officerMd = `**${officer.name}**, ${officer.title[lang]}  \n[${officer.email}](mailto:${officer.email})`;
const body = doc.body[lang].replaceAll('{{privacyOfficer}}', officerMd);
---

<PageLayout lang={lang} title={pick(doc.title, lang)!} alternates={alternatesFor(page)}>
  <p slot="hero" class="mt-6 text-sm text-muted">
    {t('legal.updated', { date: formatDate(doc.updated, lang) })}
  </p>
  <article class="container-site max-w-3xl pt-4 pb-24">
    <Prose html={renderMarkdown(body, lang)} class="text-lg" />
  </article>
</PageLayout>
