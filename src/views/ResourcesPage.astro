---
import { BookOpen, Compass, Download, ExternalLink, Handshake, Users } from '@lucide/astro';
import PageLayout from '@/layouts/PageLayout.astro';
import { alternatesFor, type Lang } from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import { getResources } from '@/lib/content';
import { resourceCategories } from '@/lib/taxonomy';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const resources = await getResources();
const icons = { guide: BookOpen, newcomers: Compass, community: Users, partners: Handshake };
const groups = resourceCategories
  .map((c) => ({ category: c, items: resources.filter((r) => r.data.category === c) }))
  .filter((g) => g.items.length);
---

<PageLayout
  lang={lang}
  title={t('resources.title')}
  lede={t('resources.lede')}
  alternates={alternatesFor('resources')}
>
  <div class="container-site space-y-16 pt-4 pb-24">
    {groups.map(({ category, items }) => {
      const Icon = icons[category];
      return (
        <section aria-labelledby={`res-${category}`}>
          <h2 id={`res-${category}`} class="mb-8 flex items-center gap-3 text-3xl font-bold">
            <span class="grid size-12 place-items-center rounded-full bg-primary text-gold-light">
              <Icon size={22} aria-hidden="true" />
            </span>
            {t(`resources.${category}`)}
          </h2>
          <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {items.map((r) => {
              const isFile = !!r.data.file;
              const href = r.data.file ?? r.data.url!;
              return (
                <li class="card group relative flex flex-col p-7 transition hover:-translate-y-1 hover:shadow-lift">
                  <h3 class="mb-2 text-xl font-bold">
                    <a
                      href={href}
                      class="text-primary no-underline after:absolute after:inset-0"
                      {...(isFile
                        ? { download: '' }
                        : { target: '_blank', rel: 'noopener noreferrer' })}
                    >
                      {pick(r.data.title, lang)}
                      {!isFile && <span class="sr-only">{t('a11y.externalLink')}</span>}
                    </a>
                  </h3>
                  <p class="mb-6 text-muted">{pick(r.data.description, lang)}</p>
                  <span
                    class="mt-auto inline-flex items-center gap-2 text-sm font-semibold text-teal"
                    aria-hidden="true"
                  >
                    {isFile ? <Download size={16} /> : <ExternalLink size={16} />}
                    {isFile
                      ? t('resources.download')
                      : new URL(href).hostname.replace(/^www\./, '')}
                  </span>
                </li>
              );
            })}
          </ul>
        </section>
      );
    })}
  </div>
</PageLayout>
