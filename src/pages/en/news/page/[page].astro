---
import type { GetStaticPaths } from 'astro';
import NewsListPage from '@/views/NewsListPage.astro';
import { getNews, NEWS_PAGE_SIZE } from '@/lib/content';

// Page 1 lives at the section root; this route builds pages 2, 3, …
export const getStaticPaths = (async () => {
  const posts = await getNews();
  const last = Math.ceil(posts.length / NEWS_PAGE_SIZE);
  return Array.from({ length: Math.max(0, last - 1) }, (_, i) => {
    const page = i + 2;
    return {
      params: { page: String(page) },
      props: {
        posts: posts.slice((page - 1) * NEWS_PAGE_SIZE, page * NEWS_PAGE_SIZE),
        current: page,
        last,
      },
    };
  });
}) satisfies GetStaticPaths;
---

<NewsListPage lang="en" {...Astro.props} />
