---
/**
 * Layout for every inner page: banner with breadcrumbs, title and intro,
 * then the page content. Breadcrumb structured data is added automatically.
 */
import { ChevronRight } from '@lucide/astro';
import BaseLayout from './BaseLayout.astro';
import LeafRule from '@/components/brand/LeafRule.astro';
import { href, type Alternates, type UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { breadcrumbJsonLd } from '@/lib/seo';

export interface Crumb {
  label: string;
  href: string;
}

interface Props {
  lang: UiLang;
  /** Visible H1. */
  title: string;
  /** <title> when different from the H1. */
  metaTitle?: string;
  description?: string;
  lede?: string;
  eyebrow?: string;
  alternates: Alternates;
  /** Intermediate crumbs between "Home" and the current page. */
  crumbs?: Crumb[];
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'event';
  jsonLd?: object[];
  noindex?: boolean;
  searchable?: boolean;
}

const {
  lang,
  title,
  metaTitle,
  description,
  lede,
  eyebrow,
  alternates,
  crumbs = [],
  image,
  imageAlt,
  type,
  jsonLd = [],
  noindex,
  searchable = true,
} = Astro.props;
const t = useTranslations(lang);
const site = Astro.site ?? new URL(Astro.url.origin);
const trail = [
  { label: t('common.home'), href: href('home', lang) },
  ...crumbs,
  { label: title, href: alternates[lang] ?? alternates.en },
];
---

<BaseLayout
  lang={lang}
  title={metaTitle ?? title}
  description={description ?? lede}
  alternates={alternates}
  image={image}
  imageAlt={imageAlt}
  type={type}
  noindex={noindex}
  searchable={searchable}
  jsonLd={[
    breadcrumbJsonLd(
      trail.map((c) => ({ name: c.label, url: c.href })),
      site,
    ),
    ...jsonLd,
  ]}
>
  <section class="mb-10 border-b border-line bg-tint" aria-labelledby="page-title">
    <div class="container-site pt-10 pb-14 sm:pt-12 sm:pb-20">
      <nav aria-label={t('a11y.breadcrumbs')} class="mb-8">
        <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-sm text-muted">
          {trail.map((c, i) => {
            const last = i === trail.length - 1;
            return (
              <li class="flex items-center gap-1.5">
                {i > 0 && (
                  <ChevronRight size={14} class="flip-rtl text-gold-dark" aria-hidden="true" />
                )}
                {last ? (
                  <span aria-current="page" class="font-semibold text-ink">
                    {c.label}
                  </span>
                ) : (
                  <a
                    href={c.href}
                    class="text-muted underline-offset-4 hover:text-ink hover:underline"
                  >
                    {c.label}
                  </a>
                )}
              </li>
            );
          })}
        </ol>
      </nav>
      <div class="flex flex-col items-center text-center">
        {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
        <h1 id="page-title" class="max-w-4xl text-4xl font-bold sm:text-5xl lg:text-6xl">
          {title}
        </h1>
        <LeafRule class="mt-6 w-48" />
        {lede && <p class="lede mt-6 max-w-2xl sm:text-xl">{lede}</p>}
        <slot name="hero" />
      </div>
    </div>
  </section>

  <slot />
</BaseLayout>
